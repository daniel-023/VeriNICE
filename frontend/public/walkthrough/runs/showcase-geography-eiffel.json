        },
        {
          "id": "doc-693f474b2011::sentence-5",
          "documentId": "doc-693f474b2011",
          "text": "The Eiffel Tower is very well-connected to the metro – there are three stations in the nearby area. ",
          "start": 301,
          "end": 401,
          "contextSpans": [],
          "context": "The Eiffel Tower is very well-connected to the metro – there are three stations in the nearby area."
        },
        {
          "id": "doc-0f740f9000ac::sentence-1",
          "documentId": "doc-0f740f9000ac",
          "text": "The Eiffel Tower was built on the Champ de Mars, in Paris’ 7th arrondissement. ",
          "start": 0,
          "end": 79,
          "contextSpans": [],
          "context": "The Eiffel Tower was built on the Champ de Mars, in Paris’ 7th arrondissement."
        },
        {
          "id": "doc-0f740f9000ac::sentence-7",
          "documentId": "doc-0f740f9000ac",
          "text": "The convention stated in Article 11 that Eiffel would build the Tower at his own expense, but benefit from a 1.5 million franc subvention to the total estimated cost of 6.5 million and could manage the tower for 20 years, starting on December 31, 1889.",
          "start": 750,
          "end": 1002,
          "contextSpans": [
            {
              "id": "doc-0f740f9000ac::sentence-6",
              "documentId": "doc-0f740f9000ac",
              "text": "A convention was signed on January 8, 1887 between Gustave Eiffel and the other stakeholders’ representatives, Édouard Lockroy, Minister of Commerce, on behalf of the national government, and Eugène Poubelle, prefect for the Seine, on behalf of the City. ",
              "start": 495,
              "end": 750,
              "direction": "PREVIOUS"
            }
          ],
          "context": "A convention was signed on January 8, 1887 between Gustave Eiffel and the other stakeholders’ representatives, Édouard Lockroy, Minister of Commerce, on behalf of the national government, and Eugène Poubelle, prefect for the Seine, on behalf of the City. The convention stated in Article 11 that Eiffel would build the Tower at his own expense, but benefit from a 1.5 million franc subvention to the total estimated cost of 6.5 million and could manage the tower for 20 years, starting on December 31, 1889."
        },
