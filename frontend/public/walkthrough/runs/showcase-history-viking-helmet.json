  "caseId": "showcase-history-viking-helmet",
  "schemaVersion": 6,
  "composition": "SINGLE",
  "warnings": [],
  "atoms": [
    {
      "id": "atom-1",
      "text": "The only preserved complete Viking Age helmet has horns.",
      "sourceText": "The only preserved complete Viking Age helmet has horns.",
      "start": 0,
      "end": 56,
      "role": "CORE"
    }
  ],
  "evidence": [
    {
      "atomId": "atom-1",
      "spans": [
        {
          "id": "doc-4437a7e42d03::sentence-4",
          "documentId": "doc-4437a7e42d03",
          "text": "However, there is only one preserved helmet from the Viking Age and this does not have horns. ",
          "start": 166,
          "end": 260,
          "contextSpans": [
            {
              "id": "doc-4437a7e42d03::sentence-3",
              "documentId": "doc-4437a7e42d03",
              "text": "Many depictions of the Vikings display this particular attribute. ",
              "start": 100,
              "end": 166,
              "direction": "PREVIOUS"
            },
            {
              "id": "doc-4437a7e42d03::sentence-5",
              "documentId": "doc-4437a7e42d03",
              "text": "It was found in the Norwegian warrior’s burial at Gjermundbu, north of Oslo, together with the only complete suit of chain mail from the period.\n",
              "start": 260,
              "end": 405,
              "direction": "NEXT"
            }
          ],
          "context": "Many depictions of the Vikings display this particular attribute. However, there is only one preserved helmet from the Viking Age and this does not have horns. It was found in the Norwegian warrior’s burial at Gjermundbu, north of Oslo, together with the only complete suit of chain mail from the period."
        },
        {
          "id": "doc-4437a7e42d03::sentence-14",
          "documentId": "doc-4437a7e42d03",
          "text": "Does this prove that all Vikings wore the famous helmets with horns? ",
          "start": 1191,
          "end": 1260,
          "contextSpans": [
            {
              "id": "doc-4437a7e42d03::sentence-13",
              "documentId": "doc-4437a7e42d03",
              "text": "In the Oseberg burial from Norway, which dates to the early Viking period, a tapestry was found on which horned helmets are also depicted. ",
              "start": 1052,
              "end": 1191,
              "direction": "PREVIOUS"
            }
          ],
          "context": "In the Oseberg burial from Norway, which dates to the early Viking period, a tapestry was found on which horned helmets are also depicted. Does this prove that all Vikings wore the famous helmets with horns?"
        },
        {
          "id": "doc-4437a7e42d03::sentence-11",
          "documentId": "doc-4437a7e42d03",
          "text": "Depictions of an Iron Age date exist featuring people with horned helmets/heads, such as upon the Golden Horns. ",
          "start": 879,
          "end": 991,
          "contextSpans": [],
          "context": "Depictions of an Iron Age date exist featuring people with horned helmets/heads, such as upon the Golden Horns."
        },
        {
          "id": "doc-231a5983562d::sentence-20",
          "documentId": "doc-231a5983562d",
          "text": "Did the Vikings have horns on their helmets?\n",
          "start": 1116,
          "end": 1161,
          "contextSpans": [],
          "context": "Did the Vikings have horns on their helmets?"
        },
        {
          "id": "doc-231a5983562d::sentence-21",
          "documentId": "doc-231a5983562d",
          "text": "No, the Vikings did not have horns on their helmets. ",
          "start": 1161,
          "end": 1214,
          "contextSpans": [
            {
              "id": "doc-231a5983562d::sentence-22",
              "documentId": "doc-231a5983562d",
              "text": "This is a myth that started in the 19th century, when Richard Wagner used horned helmets as costumes in his opera The Ring of the Nibelung.",
              "start": 1214,
              "end": 1353,
              "direction": "NEXT"
            }
          ],
          "context": "No, the Vikings did not have horns on their helmets. This is a myth that started in the 19th century, when Richard Wagner used horned helmets as costumes in his opera The Ring of the Nibelung."
        },
        {
          "id": "doc-231a5983562d::sentence-9",
          "documentId": "doc-231a5983562d",
          "text": "Is it possible to get something to eat at The Viking Museum?\n",
          "start": 436,
          "end": 497,
          "contextSpans": [
            {
              "id": "doc-231a5983562d::sentence-8",
              "documentId": "doc-231a5983562d",
              "text": "Food and Beverages\n",
              "start": 417,
              "end": 436,
              "direction": "PREVIOUS"
            }
          ],
          "context": "Food and Beverages Is it possible to get something to eat at The Viking Museum?"
        }
      ]
    }
  ],
