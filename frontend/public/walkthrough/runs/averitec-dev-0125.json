  "atoms": [
    {
      "id": "atom-1",
      "text": "The gross domestic product (GDP) figure in Nigeria has decreased.",
      "sourceText": "has decreased",
      "start": 61,
      "end": 74,
      "role": "NUMERIC_CONSTRAINT"
    },
    {
      "id": "atom-2",
      "text": "The GDP figure in Nigeria for 2020 is from the figure for 2019.",
      "sourceText": "from the figure for 2019",
