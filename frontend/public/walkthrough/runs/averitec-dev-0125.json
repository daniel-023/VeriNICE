  "atoms": [
    {
      "id": "atom-1",
      "text": "The GDP figure in Nigeria for 2020 was lower than the GDP figure for 2019.",
      "sourceText": "has decreased from the figure for 2019",
      "start": 61,
      "end": 99,
      "role": "NUMERIC_CONSTRAINT"
