  "atoms": [
    {
      "id": "atom-1",
      "text": "This Democratic Party of Joe Biden is pushing the so-called Green New Deal.",
      "sourceText": "This Democratic Party of Joe Biden is pushing the so-called Green New Deal.",
      "start": 0,
      "end": 75,
      "role": "CORE"
    },
    {
      "id": "atom-2",
      "text": "If given power they would essentially ban animal agriculture.",
      "sourceText": "they would essentially ban animal agriculture",
      "start": 92,
      "end": 137,
      "role": "CONDITIONAL"
    },
    {
      "id": "atom-3",
      "text": "If given power they would eliminate gas-powered cars.",
      "sourceText": "eliminate gas-powered cars",
