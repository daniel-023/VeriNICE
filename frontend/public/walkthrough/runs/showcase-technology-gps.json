          "contextSpans": [],
          "context": "Free Access for Civilian Use"
        },
        {
          "id": "doc-063728f3d9ea::sentence-15",
          "documentId": "doc-063728f3d9ea",
          "text": "The bulk of the GPS program is budgeted through the Department of Defense, but the Department of Transportation also contributes funding to support civilian GPS requirements.\n",
          "start": 956,
          "end": 1131,
          "contextSpans": [],
          "context": "The bulk of the GPS program is budgeted through the Department of Defense, but the Department of Transportation also contributes funding to support civilian GPS requirements."
