# Optional native local overrides. Copy to .env.local if needed.
# Keep a single local Ollama instance responsive during an in-person demo:
# serialize LLM calls (code default is 4) and cap request volume (code
# default is unlimited).
VERIGRAPH_MAX_LLM_CONCURRENCY=1
VERIGRAPH_RATE_LIMIT_PER_MINUTE=30
# VERIGRAPH_OLLAMA_URL=http://127.0.0.1:11434
# VERIGRAPH_BACKEND_URL=http://127.0.0.1:8001
# VERIGRAPH_EXPECTED_BUNDLE_DIGEST=
# Vercel shared Basic Auth (set these in Vercel, not NEXT_PUBLIC_* variables).
# VERIGRAPH_AUTH_REQUIRED=1
# BASIC_AUTH_USER=demo
# BASIC_AUTH_PASSWORD=
