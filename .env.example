VERIGRAPH_PORT=3000
VERIGRAPH_OLLAMA_MODEL=qwen2.5:3b
VERIGRAPH_OLLAMA_KEEP_ALIVE=10m
VERIGRAPH_MAX_LLM_CONCURRENCY=1
VERIGRAPH_MAX_RETRIEVAL_CONCURRENCY=1
VERIGRAPH_RATE_LIMIT_PER_MINUTE=30
