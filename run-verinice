#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${script_dir}"

usage() {
  cat <<'EOF'
Usage: ./run-verinice [--prepare|--start|--record-walkthrough|--check|--test]

  --prepare             Set up the local Python/Node runtime and model weights.
  --start               Start FastAPI, Next.js, and host Ollama locally.
  --prepare-showcase    Refresh the source-grounded showcase bundle offline.
  --record-walkthrough  Record all 18 showcase cases and build Vercel static assets.
  --check               Validate native Python and Node prerequisites.
  --test                Run backend and frontend tests natively.
EOF
}

local_env() {
  if [[ -f "${script_dir}/.env.local" ]]; then
    set -a
    # shellcheck disable=SC1091
    source "${script_dir}/.env.local"
    set +a
  fi
  export PYTHONPATH="${script_dir}/backend"
  export VERINICE_OLLAMA_URL="${VERINICE_OLLAMA_URL:-http://127.0.0.1:11434}"
  export VERINICE_OLLAMA_MODEL="${VERINICE_OLLAMA_MODEL:-qwen2.5:7b}"
  export VERINICE_EMBEDDING_MODEL_PATH="${VERINICE_EMBEDDING_MODEL_PATH:-${script_dir}/data/models/bge-small-en-v1.5}"
  export VERINICE_ENTITY_MODEL="${VERINICE_ENTITY_MODEL:-en_core_web_sm}"
  export VERINICE_BACKEND_URL="${VERINICE_BACKEND_URL:-http://127.0.0.1:8001}"
}

python_command() {
  if command -v python3.12 >/dev/null 2>&1; then
    command -v python3.12
  elif command -v python3.11 >/dev/null 2>&1; then
    command -v python3.11
  else
    echo "Python 3.11 or 3.12 is required. Install it with: brew install python@3.12" >&2
    return 127
  fi
}

ollama_ready() {
  curl -fsS "${VERINICE_OLLAMA_URL}/api/tags" >/dev/null 2>&1
}

wait_for_backend() {
  local backend_pid="$1"
  for _ in $(seq 1 180); do
    if curl -fsS "${VERINICE_BACKEND_URL}/api/v1/health" >/dev/null 2>&1; then
      return 0
    fi
    if ! kill -0 "${backend_pid}" 2>/dev/null; then
      break
    fi
    sleep 1
  done
  echo "The local backend did not become ready. Inspect data/runtime/native/backend.log" >&2
  return 1
}

wait_for_local_ui() {
  for _ in $(seq 1 180); do
    if curl -fsS http://127.0.0.1:3000/ >/dev/null 2>&1 \
      && curl -fsS http://127.0.0.1:3000/api/v1/health >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
  done
  echo "The local UI did not become ready. Inspect data/runtime/native/*.log" >&2
  return 1
}

case "${1:-}" in
  --prepare-showcase)
    local_env
    venv="${script_dir}/backend/.venv"
    [[ -x "${venv}/bin/python" ]] || { echo "Run ./run-verinice --prepare first." >&2; exit 1; }
    "${venv}/bin/python" "${script_dir}/scripts/prepare_showcase_data.py"
    echo "Source-grounded showcase bundle is ready."
    ;;
  --prepare)
    command -v npm >/dev/null 2>&1 || { echo "Node.js/npm is required." >&2; exit 1; }
    local_env
    python_bin="$(python_command)"
    venv="${script_dir}/backend/.venv"
    if [[ ! -x "${venv}/bin/python" ]] \
      || [[ "$("${venv}/bin/python" -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')" != "3.12" ]]; then
      "${python_bin}" -m venv --clear "${venv}"
    fi
    "${venv}/bin/python" -m pip install --upgrade pip
    "${venv}/bin/python" -m pip install --index-url https://download.pytorch.org/whl/cpu torch==2.6.0
    "${venv}/bin/python" -m pip install --requirement "${script_dir}/backend/requirements.lock"
    "${venv}/bin/python" -m pip install --editable "${script_dir}/backend[test]"
    "${venv}/bin/python" -c 'import os, spacy; spacy.load(os.environ["VERINICE_ENTITY_MODEL"]); print("Entity model is ready.")'
    "${venv}/bin/python" "${script_dir}/scripts/prepare_embedding_model.py"
    export HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-1}"
    export TRANSFORMERS_OFFLINE="${TRANSFORMERS_OFFLINE:-1}"
    if [[ ! -d "${script_dir}/frontend/node_modules" ]]; then
      (cd "${script_dir}/frontend" && npm ci)
    fi
    if ! ollama_ready; then
      echo "Ollama is not running at ${VERINICE_OLLAMA_URL}. Start Ollama Desktop, then run:" >&2
      echo "  ollama pull ${VERINICE_OLLAMA_MODEL}" >&2
      exit 1
    fi
    if command -v ollama >/dev/null 2>&1; then
      ollama pull "${VERINICE_OLLAMA_MODEL}"
    else
      echo "Ollama API is reachable. Ensure ${VERINICE_OLLAMA_MODEL} is installed in Ollama Desktop." >&2
    fi
    echo "Runtime is ready. Start with ./run-verinice --start"
    ;;
  --start|"")
    local_env
    venv="${script_dir}/backend/.venv"
    [[ -x "${venv}/bin/python" ]] || { echo "Run ./run-verinice --prepare first." >&2; exit 1; }
    ollama_ready || { echo "Ollama is not running at ${VERINICE_OLLAMA_URL}. Start Ollama Desktop first." >&2; exit 1; }
    if curl -fsS http://127.0.0.1:8001/api/v1/health >/dev/null 2>&1 \
      && curl -fsS http://127.0.0.1:3000/ >/dev/null 2>&1; then
      echo "VeriNICE is already running at http://localhost:3000"
      exit 0
    fi
    if lsof -nP -iTCP:8001 -sTCP:LISTEN >/dev/null 2>&1 \
      || lsof -nP -iTCP:3000 -sTCP:LISTEN >/dev/null 2>&1; then
      echo "Port 3000 or 8001 is occupied by an incomplete VeriNICE instance." >&2
      echo "Stop the existing instance, then run ./run-verinice --start again." >&2
      exit 1
    fi
    mkdir -p "${script_dir}/data/runtime/native"
    "${venv}/bin/python" -m uvicorn verinice_backend.api:app --host 127.0.0.1 --port 8001 >"${script_dir}/data/runtime/native/backend.log" 2>&1 &
    backend_pid=$!
    frontend_pid=""
    cleanup() {
      kill "${backend_pid}" 2>/dev/null || true
      if [[ -n "${frontend_pid}" ]]; then
        kill "${frontend_pid}" 2>/dev/null || true
      fi
    }
    trap cleanup INT TERM EXIT
    wait_for_backend "${backend_pid}"
    (cd "${script_dir}/frontend" && exec "${script_dir}/frontend/node_modules/.bin/next" dev) >"${script_dir}/data/runtime/native/frontend.log" 2>&1 &
    frontend_pid=$!
    wait_for_local_ui
    echo "VeriNICE running at http://localhost:3000 (Ctrl-C to stop)"
    while kill -0 "${backend_pid}" 2>/dev/null && kill -0 "${frontend_pid}" 2>/dev/null; do sleep 1; done
    ;;
  --record-walkthrough)
    local_env
    venv="${script_dir}/backend/.venv"
    [[ -x "${venv}/bin/python" ]] || { echo "Run ./run-verinice --prepare first." >&2; exit 1; }
    wait_for_local_ui
    mkdir -p "${script_dir}/data/runtime/native"
    walkthrough_stage="$(mktemp -d "${script_dir}/data/runtime/native/walkthrough-stage.XXXXXX")"
    cleanup_walkthrough_stage() {
      rm -rf "${walkthrough_stage}"
    }
    trap cleanup_walkthrough_stage EXIT
    staged_runs="${walkthrough_stage}/runs"
    staged_assets="${walkthrough_stage}/assets"
    "${venv}/bin/python" "${script_dir}/scripts/record_walkthrough.py" \
      --api "${VERINICE_BACKEND_URL}" --output "${staged_runs}"
    "${venv}/bin/python" "${script_dir}/scripts/build_walkthrough.py" \
      --runs "${staged_runs}" --output "${staged_assets}" --require-complete
    published_runs="${script_dir}/data/walkthrough/runs"
    published_assets="${script_dir}/frontend/public/walkthrough"
    previous_runs="${walkthrough_stage}/previous-runs"
    previous_assets="${walkthrough_stage}/previous-assets"
    publish_walkthrough() {
      mv "${published_runs}" "${previous_runs}" || return 1
      mv "${published_assets}" "${previous_assets}" || {
        mv "${previous_runs}" "${published_runs}"
        return 1
      }
      mv "${staged_runs}" "${published_runs}" || {
        mv "${previous_runs}" "${published_runs}"
        mv "${previous_assets}" "${published_assets}"
        return 1
      }
      mv "${staged_assets}" "${published_assets}" || {
        mv "${published_runs}" "${staged_runs}"
        mv "${previous_runs}" "${published_runs}"
        mv "${previous_assets}" "${published_assets}"
        return 1
      }
    }
    # Keep the backup on disk if this process is interrupted during the two
    # directory swaps. Normal failures roll back both destinations below.
    trap - EXIT
    if ! publish_walkthrough; then
      echo "Could not publish the validated walkthrough; previous assets were restored." >&2
      rm -rf "${walkthrough_stage}"
      exit 1
    fi
    rm -rf "${walkthrough_stage}"
    echo "Recorded walkthrough assets are ready in frontend/public/walkthrough/."
    ;;
  --check)
    local_env
    python_command >/dev/null
    command -v npm >/dev/null
    venv="${script_dir}/backend/.venv"
    if [[ -x "${venv}/bin/python" ]]; then
      "${venv}/bin/python" -c 'import os, spacy; spacy.load(os.environ["VERINICE_ENTITY_MODEL"])' \
        || { echo "The configured entity model is unavailable. Run ./run-verinice --prepare." >&2; exit 1; }
    fi
    echo "Local prerequisites are available."
    ;;
  --test)
    local_env
    venv="${script_dir}/backend/.venv"
    [[ -x "${venv}/bin/python" ]] || { echo "Run ./run-verinice --prepare first." >&2; exit 1; }
    "${venv}/bin/python" -m pytest "${script_dir}/backend/tests"
    (cd "${script_dir}/frontend" && npm test -- --run)
    ;;
  *)
    usage
    exit 2
    ;;
esac
